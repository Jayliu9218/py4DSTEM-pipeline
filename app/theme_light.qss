/* =========================================================================
 * py4DSTEM Pipeline — Light theme
 * Loaded on-demand when user switches to Light Theme via View menu.
 * ========================================================================= */

QMainWindow,
QWidget {
    background: #ececec;
    color: #212121;
    font-size: 9pt;
}

QDialog { background: #ececec; color: #212121; }

QMenuBar {
    background: #ececec;
    color: #212121;
    border-bottom: 1px solid #d0d0d0;
    padding: 2px;
}
QMenuBar::item { background: transparent; padding: 4px 10px; }
QMenuBar::item:selected { background: #1976d2; color: #ffffff; }
QMenu {
    background: #ffffff;
    color: #212121;
    border: 1px solid #d0d0d0;
}
QMenu::item { padding: 5px 20px; }
QMenu::item:selected { background: #1976d2; color: #ffffff; }

QWidget#projectToolbar { background: #ececec; border-bottom: 1px solid #d0d0d0; }
QWidget#routeBar { background: #f0f0f0; border-bottom: 1px solid #d0d0d0; }
QToolButton#routeButton {
    background: transparent;
    border: none;
    padding: 6px 12px;
    color: #424242;
    font-size: 9pt;
}
QToolButton#routeButton:checked {
    background: #1976d2;
    color: #ffffff;
    border-radius: 2px;
    font-weight: bold;
}
QToolButton#routeButton:hover:!checked {
    background: #d6e4f0;
    color: #212121;
    border-radius: 2px;
}
/* Stub / not-yet-implemented route modules — greyed out and non-interactive. */
QToolButton#routeButton[implemented="false"] {
    color: #bdbdbd;
}
QToolButton#routeButton[implemented="false"]:checked {
    background: #ececec;
    color: #9e9e9e;
}
QLabel#routeArrow { color: #9e9e9e; font-size: 10pt; }

QFrame#workflowDivider,
QFrame#logDivider {
    background: #d0d0d0;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

QSplitter::handle { background: #c8cdd3; }
QSplitter::handle:horizontal { width: 4px; }
QSplitter::handle:vertical { height: 4px; }

QTreeWidget {
    background: #ffffff;
    color: #212121;
    border: 1px solid #d0d0d0;
    border-radius: 2px;
    alternate-background-color: #fafafa;
}
QTreeWidget::item:selected { background: #1976d2; color: #ffffff; }
QTreeWidget::item:!selected:hover { background: #e0eef9; }
QHeaderView::section {
    background: #e7ebef;
    color: #212121;
    padding: 4px;
    border: none;
    border-right: 1px solid #c8cdd3;
    border-bottom: 1px solid #c8cdd3;
    font-weight: bold;
}

QWidget#moduleControlPanel { background: #ececec; border-left: 1px solid #a8aeb4; }
QLabel#moduleTitle { font-size: 10pt; font-weight: bold; color: #212121; padding: 2px 0; }
QLabel#sectionTitle { font-size: 9pt; font-weight: bold; color: #424242; }

QGroupBox {
    border: 1px solid #b8bec4;
    border-radius: 2px;
    margin-top: 4px;
    padding: 8px;
    padding-top: 18px;
    background: #e8eaed;
    color: #212121;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0px;
    margin-left: 0px;
    padding: 3px 8px;
    background: #c8cdd3;
    border: none;
    border-radius: 0px;
    color: #1a1a1a;
}

/* --- Table-like parameter forms (object-name paramForm) ----------------- */
QGroupBox#paramForm {
    border: 1px solid #b8bec4;
    border-radius: 2px;
    background: #e8eaed;
}
QGroupBox#paramForm::title {
    background: #c8cdd3;
    border-bottom: 1px solid #a8aeb4;
    border-radius: 0px;
    padding: 4px 8px;
    color: #1a1a1a;
}
/* Inputs stay pure-white to pop against the grey box body (instrument style). */
QGroupBox#paramForm QLineEdit,
QGroupBox#paramForm QComboBox,
QGroupBox#paramForm QSpinBox,
QGroupBox#paramForm QDoubleSpinBox {
    background: #ffffff;
    border: 1px solid #8a9098;
    min-height: 20px;
    max-height: 20px;
    border-radius: 2px;
}
QGroupBox#paramForm QLineEdit:hover,
QGroupBox#paramForm QComboBox:hover,
QGroupBox#paramForm QSpinBox:hover,
QGroupBox#paramForm QDoubleSpinBox:hover {
    background: #f0f4f8;
}
QGroupBox#paramForm QComboBox::drop-down {
    background: #d0d4d8;
    border-left: 1px solid #8a9098;
}
QGroupBox#paramForm QComboBox::drop-down:hover { background: #c4c8cc; }
QGroupBox#paramForm QPushButton {
    min-height: 20px;
    border-radius: 2px;
}
/* Zebra striping: every second row pair gets a contrasting background
   on the label side, giving the dense parameter form a readable table rhythm. */
QGroupBox#paramForm QLabel#paramRowOdd {
    background: #dfe3e8;
}

QTableWidget {
    background: #ffffff;
    color: #212121;
    border: 1px solid #d0d0d0;
    gridline-color: #d8dde2;
    alternate-background-color: #fafafa;
}
QTableWidget::item:selected { background: #1976d2; color: #ffffff; }

QComboBox, QSpinBox, QDoubleSpinBox, QLineEdit {
    background: #ffffff;
    color: #212121;
    border: 1px solid #c8cdd3;
    border-radius: 2px;
    padding: 2px 6px;
    min-height: 20px;
    selection-background-color: #1976d2;
    selection-color: #ffffff;
}
QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover, QLineEdit:hover { background: #f5faff; }
QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QLineEdit:focus { border: 1px solid #1976d2; }
QComboBox::drop-down {
    border: none;
    border-left: 1px solid #c8cdd3;
    background: #ececec;
    width: 20px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
}
QComboBox::drop-down:hover { background: #dfe5ea; }
QComboBox::down-arrow { width: 9px; height: 9px; }
QComboBox QAbstractItemView {
    background: #ffffff;
    color: #212121;
    border: 1px solid #d0d0d0;
    selection-background-color: #1976d2;
    selection-color: #ffffff;
}

QPushButton {
    background: #e8e8e8;
    color: #212121;
    border: 1px solid #c8cdd3;
    border-radius: 2px;
    padding: 5px 14px;
    min-height: 18px;
}
QPushButton:hover { background: #d6e4f0; }
QPushButton:pressed { background: #1976d2; color: #ffffff; }
QPushButton:disabled { background: #f0f0f0; color: #9e9e9e; border: 1px solid #e0e0e0; }

QCheckBox, QRadioButton { color: #212121; spacing: 6px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 14px; height: 14px;
    border: 1px solid #c8cdd3;
    border-radius: 2px;
    background: #ffffff;
}
QCheckBox::indicator:checked { background: #1976d2; border: 1px solid #1976d2; }

QProgressBar {
    background: #e0e0e0;
    color: #212121;
    border: 1px solid #d0d0d0;
    border-radius: 2px;
    text-align: center;
    min-height: 18px;
}
QProgressBar::chunk { background: #1976d2; border-radius: 0px; }

QTabWidget::pane { border: 1px solid #d0d0d0; border-radius: 2px; background: #ffffff; }
QTabBar::tab {
    background: #ececec;
    color: #757575;
    border: 1px solid #d0d0d0;
    border-bottom: none;
    padding: 5px 12px;
    margin-right: 2px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}
QTabBar::tab:selected { background: #ffffff; color: #1976d2; border-bottom: 1px solid #ffffff; font-weight: bold; }
QTabBar::tab:hover:!selected { background: #d6e4f0; color: #212121; }

QPlainTextEdit, QTextEdit {
    background: #ffffff;
    color: #424242;
    border: 1px solid #d0d0d0;
    border-radius: 2px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
}

QStatusBar { background: #ececec; color: #424242; border-top: 1px solid #d0d0d0; }
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #424242; padding: 0 6px; }

QScrollBar:vertical { background: #f0f0f0; width: 10px; border: none; }
QScrollBar::handle:vertical { background: #c8cdd3; border-radius: 0px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: #1976d2; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: #f0f0f0; }
QScrollBar:horizontal { background: #f0f0f0; height: 10px; border: none; }
QScrollBar::handle:horizontal { background: #c8cdd3; border-radius: 0px; min-width: 24px; }
QScrollBar::handle:horizontal:hover { background: #1976d2; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: #f0f0f0; }

QScrollArea { background: transparent; border: none; }

QDockWidget {
    color: #212121;
    border: 1px solid #a8aeb4;
}
QDockWidget::title {
    background: #c8cdd3;
    border-bottom: 2px solid #98a0a8;
    padding: 5px 8px;
    text-align: left;
    color: #1a1a1a;
    font-weight: bold;
}

QMessageBox { background: #ececec; }
QMessageBox QLabel { color: #212121; }

QToolTip { background: #ffffff; color: #212121; border: 1px solid #1976d2; padding: 4px; }

QLabel { color: #212121; background: transparent; }
QLabel#viewerTitle { background: #f0f0f0; color: #424242; font-weight: bold; padding: 3px 6px; }
