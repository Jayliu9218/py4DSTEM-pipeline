/* Compact industrial-light instrument theme. */

QMainWindow, QWidget {
    background: #dedede;
    color: #111111;
    font-size: 9pt;
}
QDialog { background: #dedede; color: #111111; }
QLabel { color: #111111; background: transparent; }

QMenuBar {
    background: #d1d1d1;
    color: #111111;
    border-bottom: 1px solid #858585;
    padding: 1px;
}
QMenuBar::item { background: transparent; padding: 3px 8px; }
QMenuBar::item:selected { background: #b9d4e8; color: #111111; }
QMenu {
    background: #eeeeee;
    color: #111111;
    border: 1px solid #777777;
}
QMenu::item { padding: 4px 18px; }
QMenu::item:selected { background: #2d79b7; color: #ffffff; }
QMenu::separator { height: 1px; background: #a0a0a0; margin: 3px 5px; }

QToolBar {
    background: #d1d1d1;
    border: none;
    border-bottom: 1px solid #858585;
    spacing: 3px;
    padding: 2px;
}
QToolBar::separator { background: #919191; width: 1px; margin: 3px 5px; }
QToolBar QToolButton {
    background: #e4e4e4;
    border: 1px solid #8c8c8c;
    padding: 3px 7px;
}
QToolBar QToolButton:hover { background: #f4f4f4; border-color: #2d79b7; }
QToolBar QToolButton:pressed, QToolBar QToolButton:checked {
    background: #b9d4e8;
    border-color: #2d79b7;
}

QWidget#projectToolbar {
    background: #d2d2d2;
    border-bottom: 1px solid #8a8a8a;
}
QWidget#routeBar {
    background: #c7c7c7;
    border-bottom: 1px solid #777777;
}
QToolButton#routeButton {
    background: #e1e1e1;
    color: #303030;
    border: 1px solid #8d8d8d;
    padding: 3px 5px;
    font-size: 8pt;
}
QToolButton#routeButton:checked {
    background: #d7e8f4;
    color: #075f9d;
    border: 1px solid #2d79b7;
    font-weight: bold;
}
QToolButton#routeButton:hover:!checked { background: #f1f1f1; border-color: #2d79b7; }
QToolButton#routeButton[implemented="false"] { color: #929292; background: #d3d3d3; }
QToolButton#routeButton[implemented="false"]:checked { color: #929292; background: #d3d3d3; }
QLabel#routeArrow { color: #555555; font-size: 9pt; }

QFrame#workflowDivider, QFrame#logDivider {
    background: #777777;
    border: none;
    max-height: 1px;
    min-height: 1px;
}
QSplitter::handle { background: #8a8a8a; }
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical { height: 3px; }

QWidget#moduleControlPanel {
    background: #d9d9d9;
    border-left: 2px solid #6f6f6f;
}
QStackedWidget#moduleControlsSurface {
    background: #ffffff;
    border: 1px solid #858585;
}
QScrollArea#moduleControlsScroll,
QScrollArea#moduleControlsScroll > QWidget > QWidget,
QWidget#moduleControlsContent {
    background: #ffffff;
}
QLabel#moduleTitle {
    background: #a9a9a9;
    color: #111111;
    border: 1px solid #777777;
    font-size: 9pt;
    font-weight: bold;
    padding: 3px 5px;
}
QLabel#sectionTitle { color: #333333; font-size: 9pt; font-weight: bold; }

QGroupBox {
    background: #e5e5e5;
    color: #111111;
    border: 1px solid #898989;
    border-radius: 0;
    margin-top: 5px;
    padding: 5px;
    padding-top: 19px;
    font-weight: normal;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0;
    right: 0;
    background: #ababab;
    color: #111111;
    border: none;
    border-bottom: 1px solid #777777;
    padding: 2px 6px;
    font-weight: bold;
}
QGroupBox#paramForm { background: #e8e8e8; border-color: #858585; }
QGroupBox#paramForm::title {
    background: #a6a6a6;
    color: #111111;
    border-bottom: 1px solid #777777;
    padding: 2px 6px;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background: #ffffff;
    color: #111111;
    border: 1px solid #8b8b8b;
    border-radius: 0;
    padding: 1px 4px;
    min-height: 18px;
    max-height: 20px;
    selection-background-color: #2d79b7;
    selection-color: #ffffff;
}
QLineEdit:hover, QComboBox:hover, QSpinBox:hover, QDoubleSpinBox:hover {
    border-color: #4f7895;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #2d79b7;
}
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QDoubleSpinBox:disabled {
    background: #d5d5d5;
    color: #858585;
    border-color: #ababab;
}
QComboBox QAbstractItemView {
    background: #ffffff;
    color: #111111;
    border: 1px solid #777777;
    selection-background-color: #2d79b7;
    selection-color: #ffffff;
}
QComboBox QAbstractItemView::item { min-height: 18px; padding: 1px 5px; }

QPushButton {
    background: #dddddd;
    color: #111111;
    border: 1px solid #777777;
    border-top-color: #f5f5f5;
    border-left-color: #f5f5f5;
    border-radius: 0;
    padding: 2px 10px;
    min-height: 19px;
}
QPushButton:hover { background: #edf4f8; border-color: #2d79b7; }
QPushButton:pressed {
    background: #b9d4e8;
    border: 1px solid #5f5f5f;
    border-top-color: #5f5f5f;
    border-left-color: #5f5f5f;
}
QPushButton:checked { background: #c7dfef; border-color: #2d79b7; }
QPushButton:disabled {
    background: #d2d2d2;
    color: #929292;
    border: 1px solid #b2b2b2;
}
QPushButton#exportButton { font-weight: bold; }
QWidget#dataPreviewBar {
    background: #d9d9d9;
    border-top: 1px solid #8a8a8a;
}
QLabel#dataPreviewHint {
    color: #4f4f4f;
    font-size: 8pt;
    padding-left: 1px;
}
QPushButton#previewSelectedButton {
    background: #c9e4f5;
    color: #0f2f45;
    border: 1px solid #2d79b7;
    border-top-color: #f4fbff;
    border-left-color: #f4fbff;
    font-weight: bold;
    min-height: 24px;
    max-height: 28px;
    padding: 3px 12px;
}
QPushButton#previewSelectedButton:hover,
QPushButton#previewSelectedButton:focus {
    background: #dff1fb;
    border: 1px solid #136aa8;
}
QPushButton#previewSelectedButton:pressed {
    background: #8fc3e5;
    border: 1px solid #5f5f5f;
    border-top-color: #5f5f5f;
    border-left-color: #5f5f5f;
}
QPushButton#previewSelectedButton:disabled {
    background: #d2d2d2;
    color: #7d7d7d;
    border: 1px solid #a8a8a8;
    font-weight: bold;
}
QWidget#moduleControlPanel QPushButton {
    background: #d8d8d8;
    border: 1px solid #777777;
    border-top-color: #f5f5f5;
    border-left-color: #f5f5f5;
    padding: 2px 8px;
    min-height: 20px;
    max-height: 24px;
}
QWidget#moduleControlPanel QPushButton:hover {
    background: #edf4f8;
    border-color: #2d79b7;
}
QWidget#moduleControlPanel QPushButton:focus {
    border: 1px solid #2d79b7;
}
QWidget#moduleControlPanel QPushButton:pressed {
    background: #b9d4e8;
    border: 1px solid #5f5f5f;
}
QWidget#moduleControlPanel QPushButton:disabled {
    background: #d2d2d2;
    color: #929292;
    border: 1px solid #b2b2b2;
}

QCheckBox, QRadioButton { color: #111111; spacing: 5px; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 12px;
    height: 12px;
    background: #ffffff;
    border: 1px solid #777777;
    border-radius: 0;
}
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #2d79b7; }
QCheckBox::indicator:checked { background: #2d79b7; border-color: #1f659d; }
QRadioButton::indicator { border-radius: 7px; }
QRadioButton::indicator:checked { background: #2d79b7; border: 2px solid #ffffff; }

QProgressBar {
    background: #f5f5f5;
    color: #111111;
    border: 1px solid #a0a0a0;
    border-radius: 0;
    text-align: center;
    min-height: 16px;
    max-height: 18px;
}
QProgressBar::chunk { background: #4f9c55; border: none; }

QTreeWidget, QTableWidget {
    background: #ffffff;
    color: #111111;
    border: 1px solid #858585;
    gridline-color: #c8c8c8;
    alternate-background-color: #eeeeee;
}
QTreeWidget::item, QTableWidget::item { min-height: 18px; }
QTreeWidget::item:selected, QTableWidget::item:selected { background: #2d79b7; color: #ffffff; }
QTreeWidget::item:!selected:hover { background: #d7e8f4; }
QHeaderView::section {
    background: #b0b0b0;
    color: #111111;
    padding: 2px 4px;
    border: none;
    border-right: 1px solid #858585;
    border-bottom: 1px solid #777777;
    font-weight: bold;
}

QTabWidget::pane {
    background: #e7e7e7;
    border: 1px solid #858585;
    border-radius: 0;
}
QTabBar::tab {
    background: #c9c9c9;
    color: #222222;
    border: 1px solid #858585;
    border-bottom: none;
    padding: 3px 9px;
    margin-right: 1px;
}
QTabBar::tab:selected { background: #eeeeee; color: #111111; font-weight: bold; }
QTabBar::tab:hover:!selected { background: #dceaf3; }

QPlainTextEdit, QTextEdit, QTextBrowser {
    background: #ffffff;
    color: #202020;
    border: 1px solid #858585;
    border-radius: 0;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
}
QScrollArea { background: transparent; border: none; }
QScrollBar:vertical { background: #d4d4d4; width: 12px; border: 1px solid #a0a0a0; }
QScrollBar::handle:vertical { background: #a5a5a5; border: 1px solid #777777; min-height: 22px; }
QScrollBar::handle:vertical:hover { background: #8eb7d3; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: #d4d4d4; }
QScrollBar:horizontal { background: #d4d4d4; height: 12px; border: 1px solid #a0a0a0; }
QScrollBar::handle:horizontal { background: #a5a5a5; border: 1px solid #777777; min-width: 22px; }
QScrollBar::handle:horizontal:hover { background: #8eb7d3; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: #d4d4d4; }

QDockWidget { color: #111111; border: 1px solid #777777; }
QDockWidget::title {
    background: #a7a7a7;
    color: #111111;
    border-bottom: 1px solid #696969;
    padding: 3px 6px;
    text-align: left;
    font-weight: bold;
}
QStatusBar {
    background: #c9c9c9;
    color: #222222;
    border-top: 1px solid #777777;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: #222222; padding: 0 4px; }

QMessageBox { background: #dedede; }
QMessageBox QLabel { color: #111111; }
QToolTip { background: #fffbd6; color: #111111; border: 1px solid #777777; padding: 3px; }
QLabel#viewerTitle {
    background: #b0b0b0;
    color: #111111;
    border-bottom: 1px solid #777777;
    font-weight: bold;
    padding: 2px 5px;
}
