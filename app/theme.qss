/* =========================================================================
 * py4DSTEM Pipeline — SEM/FIB dark-gray instrument theme
 * Applied globally via QApplication.setStyleSheet() in main.py.
 * Object-name selectors target hooks set in the widget code:
 *   #projectToolbar, #routeBar, #moduleControlPanel, #moduleTitle,
 *   #sectionTitle, #workflowDivider, #logDivider, #routeArrow,
 *   #routeButton, #viewerTitle
 * ========================================================================= */

/* --- Base ---------------------------------------------------------------- */
QMainWindow,
QWidget {
    background: #2b2b2b;
    color: #e0e0e0;
    font-size: 9pt;
}

QDialog {
    background: #2b2b2b;
    color: #e0e0e0;
}

/* --- Menu bar ------------------------------------------------------------ */
QMenuBar {
    background: #333333;
    color: #e0e0e0;
    border-bottom: 1px solid #3c3c3c;
    padding: 2px;
}
QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
}
QMenuBar::item:selected {
    background: #4a9eff;
    color: #ffffff;
}
QMenu {
    background: #333333;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
}
QMenu::item {
    padding: 5px 20px;
}
QMenu::item:selected {
    background: #4a9eff;
    color: #ffffff;
}

/* --- Tool bar ------------------------------------------------------------ */
QToolBar {
    background: #333333;
    color: #e0e0e0;
    border: none;
    border-bottom: 1px solid #3c3c3c;
    spacing: 4px;
    padding: 3px;
}
QToolBar::separator {
    background: #3c3c3c;
    width: 1px;
    margin: 4px 6px;
}
QToolBar QToolButton {
    padding: 4px 8px;
    border: none;
    border-radius: 3px;
    color: #e0e0e0;
}
QToolBar QToolButton:hover {
    background: #4a6878;
}
QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background: #4a9eff;
    color: #ffffff;
}

/* --- Project toolbar & route bar ---------------------------------------- */
QWidget#projectToolbar {
    background: #333333;
    border-bottom: 1px solid #3c3c3c;
}
QWidget#routeBar {
    background: #2f2f2f;
    border-bottom: 1px solid #3c3c3c;
}
QToolButton#routeButton {
    background: transparent;
    border: none;
    padding: 6px 12px;
    color: #c0c0c0;
    font-size: 9pt;
}
QToolButton#routeButton:checked {
    background: #4a6878;
    color: #ffffff;
    border-radius: 3px;
    font-weight: bold;
}
QToolButton#routeButton:hover:!checked {
    background: #3a4a5a;
    color: #e0e0e0;
    border-radius: 3px;
}
QLabel#routeArrow {
    color: #666666;
    font-size: 10pt;
}

/* --- Dividers ------------------------------------------------------------ */
QFrame#workflowDivider,
QFrame#logDivider {
    background: #3c3c3c;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* --- Splitters ----------------------------------------------------------- */
QSplitter::handle {
    background: #3c3c3c;
}
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

/* --- Tree (data browser) ------------------------------------------------- */
QTreeWidget {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    alternate-background-color: #252525;
}
QTreeWidget::item:selected {
    background: #4a9eff;
    color: #ffffff;
}
QTreeWidget::item:!selected:hover {
    background: #3a4a5a;
}
QHeaderView::section {
    background: #383838;
    color: #e0e0e0;
    padding: 4px;
    border: none;
    border-right: 1px solid #3c3c3c;
    border-bottom: 1px solid #3c3c3c;
    font-weight: bold;
}

/* --- Module control panel ------------------------------------------------ */
QWidget#moduleControlPanel {
    background: #2b2b2b;
    border-left: 1px solid #3c3c3c;
}
QLabel#moduleTitle {
    font-size: 10pt;
    font-weight: bold;
    color: #e0e0e0;
    padding: 2px 0;
}
QLabel#sectionTitle {
    font-size: 9pt;
    font-weight: bold;
    color: #b0b0b0;
}

/* --- Group boxes (flat cards) ------------------------------------------- */
QGroupBox {
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    margin-top: 10px;
    padding: 8px;
    background: #2f2f2f;
    color: #e0e0e0;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 1px 6px;
    background: #3a3a3a;
    border-radius: 2px;
    color: #b0b0b0;
}

/* --- Tables -------------------------------------------------------------- */
QTableWidget {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    gridline-color: #404040;
    alternate-background-color: #252525;
}
QTableWidget::item:selected {
    background: #4a9eff;
    color: #ffffff;
}
QHeaderView::section {
    background: #383838;
}

/* --- Inputs (combo / spin / line edit) ---------------------------------- */
QComboBox,
QSpinBox,
QDoubleSpinBox,
QLineEdit {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #404040;
    border-radius: 3px;
    padding: 3px 6px;
    min-height: 18px;
    selection-background-color: #4a9eff;
    selection-color: #ffffff;
}
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QLineEdit:hover {
    border: 1px solid #4a9eff;
}
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QLineEdit:focus {
    border: 1px solid #4a9eff;
}
QComboBox::drop-down {
    border: none;
    width: 18px;
}
QComboBox QAbstractItemView {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #404040;
    selection-background-color: #4a9eff;
    selection-color: #ffffff;
}
QComboBox QAbstractItemView::item {
    padding: 3px 8px;
}

/* --- Buttons ------------------------------------------------------------- */
QPushButton {
    background: #383838;
    color: #e0e0e0;
    border: 1px solid #404040;
    border-radius: 3px;
    padding: 5px 14px;
    min-height: 18px;
}
QPushButton:hover {
    background: #404040;
    border: 1px solid #4a9eff;
}
QPushButton:pressed {
    background: #4a9eff;
    color: #ffffff;
}
QPushButton:disabled {
    background: #2b2b2b;
    color: #666666;
    border: 1px solid #333333;
}

/* --- Check boxes & radio ------------------------------------------------- */
QCheckBox,
QRadioButton {
    color: #e0e0e0;
    spacing: 6px;
}
QCheckBox::indicator,
QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #555555;
    border-radius: 2px;
    background: #1e1e1e;
}
QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border: 1px solid #4a9eff;
}
QCheckBox::indicator:checked {
    background: #4a9eff;
    border: 1px solid #4a9eff;
}

/* --- Progress bar -------------------------------------------------------- */
QProgressBar {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    text-align: center;
    min-height: 18px;
}
QProgressBar::chunk {
    background: #4a9eff;
    border-radius: 2px;
}

/* --- Tabs ---------------------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    background: #1e1e1e;
}
QTabBar::tab {
    background: #2b2b2b;
    color: #a0a0a0;
    border: 1px solid #3c3c3c;
    border-bottom: none;
    padding: 5px 12px;
    margin-right: 2px;
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
}
QTabBar::tab:selected {
    background: #1e1e1e;
    color: #4a9eff;
    border-bottom: 1px solid #1e1e1e;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background: #383838;
    color: #e0e0e0;
}

/* --- Text outputs (logs) ------------------------------------------------- */
QPlainTextEdit,
QTextEdit {
    background: #1e1e1e;
    color: #c0c0c0;
    border: 1px solid #3c3c3c;
    border-radius: 3px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
}

/* --- Status bar ---------------------------------------------------------- */
QStatusBar {
    background: #333333;
    color: #b0b0b0;
    border-top: 1px solid #3c3c3c;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: #b0b0b0;
    padding: 0 6px;
}

/* --- Scroll bars --------------------------------------------------------- */
QScrollBar:vertical {
    background: #2b2b2b;
    width: 12px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #4a4a4a;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #4a9eff;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: #2b2b2b; }
QScrollBar:horizontal {
    background: #2b2b2b;
    height: 12px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #4a4a4a;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #4a9eff;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: #2b2b2b; }

/* --- Scroll area --------------------------------------------------------- */
QScrollArea {
    background: transparent;
    border: none;
}

/* --- Dock widgets -------------------------------------------------------- */
QDockWidget {
    color: #e0e0e0;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
QDockWidget::title {
    background: #333333;
    border-bottom: 1px solid #3c3c3c;
    padding: 4px 8px;
    text-align: left;
    color: #b0b0b0;
    font-weight: bold;
}

/* --- Message box --------------------------------------------------------- */
QMessageBox {
    background: #2b2b2b;
}
QMessageBox QLabel {
    color: #e0e0e0;
}

/* --- Tool tip ------------------------------------------------------------ */
QToolTip {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #4a9eff;
    padding: 4px;
}

/* --- Scroll area content margins ---------------------------------------- */
QLabel {
    color: #e0e0e0;
    background: transparent;
}

/* --- Figure panel title -------------------------------------------------- */
QLabel#viewerTitle {
    background: #1e1e1e;
    color: #b0b0b0;
    font-weight: bold;
    padding: 3px 6px;
}
