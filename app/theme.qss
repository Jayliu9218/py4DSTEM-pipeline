/* =========================================================================
 * py4DSTEM Pipeline — SEM/FIB dark-gray instrument theme
 * Applied globally via QApplication.setStyleSheet() in main.py.
 * Object-name selectors target hooks set in the widget code:
 *   #projectToolbar, #routeBar, #moduleControlPanel, #moduleTitle,
 *   #sectionTitle, #workflowDivider, #logDivider, #routeArrow,
 *   #routeButton, #viewerTitle
 * ========================================================================= */

/* --- Base ---------------------------------------------------------------- */
QMainWindow,
QWidget {
    background: #2b2b2b;
    color: #e0e0e0;
    font-size: 9pt;
}

QDialog {
    background: #2b2b2b;
    color: #e0e0e0;
}

/* --- Menu bar ------------------------------------------------------------ */
QMenuBar {
    background: #333333;
    color: #e0e0e0;
    border-bottom: 1px solid #3c3c3c;
    padding: 1px;
}
QMenuBar::item {
    background: transparent;
    padding: 3px 8px;
}
QMenuBar::item:selected {
    background: #4a9eff;
    color: #ffffff;
}
QMenu {
    background: #333333;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
}
QMenu::item {
    padding: 4px 18px;
}
QMenu::item:selected {
    background: #4a9eff;
    color: #ffffff;
}

/* --- Tool bar ------------------------------------------------------------ */
QToolBar {
    background: #333333;
    color: #e0e0e0;
    border: none;
    border-bottom: 1px solid #3c3c3c;
    spacing: 3px;
    padding: 2px;
}
QToolBar::separator {
    background: #3c3c3c;
    width: 1px;
    margin: 4px 6px;
}
QToolBar QToolButton {
    padding: 3px 7px;
    border: none;
    border-radius: 2px;
    color: #e0e0e0;
}
QToolBar QToolButton:hover {
    background: #4a6878;
}
QToolBar QToolButton:pressed,
QToolBar QToolButton:checked {
    background: #4a9eff;
    color: #ffffff;
}

/* --- Project toolbar & route bar ---------------------------------------- */
QWidget#projectToolbar {
    background: #333333;
    border-bottom: 1px solid #3c3c3c;
}
QWidget#routeBar {
    background: #2f2f2f;
    border-bottom: 1px solid #3c3c3c;
}
QToolButton#routeButton {
    background: transparent;
    border: none;
    padding: 3px 5px;
    color: #c0c0c0;
    font-size: 8pt;
}
QToolButton#routeButton:checked {
    background: #4a6878;
    color: #ffffff;
    border-radius: 2px;
    font-weight: bold;
}
QToolButton#routeButton:hover:!checked {
    background: #3a4a5a;
    color: #e0e0e0;
    border-radius: 2px;
}
/* Stub / not-yet-implemented route modules — greyed out and non-interactive. */
QToolButton#routeButton[implemented="false"] {
    color: #555555;
}
QToolButton#routeButton[implemented="false"]:checked {
    background: #2a2a2a;
    color: #666666;
}
QLabel#routeArrow {
    color: #666666;
    font-size: 10pt;
}

/* --- Dividers ------------------------------------------------------------ */
QFrame#workflowDivider,
QFrame#logDivider {
    background: #3c3c3c;
    border: none;
    max-height: 1px;
    min-height: 1px;
}

/* --- Splitters ----------------------------------------------------------- */
QSplitter::handle {
    background: #4a4a4a;
}
QSplitter::handle:horizontal { width: 3px; }
QSplitter::handle:vertical { height: 3px; }

/* --- Tree (data browser) ------------------------------------------------- */
QTreeWidget {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    alternate-background-color: #252525;
}
QTreeWidget::item:selected {
    background: #4a9eff;
    color: #ffffff;
}
QTreeWidget::item:!selected:hover {
    background: #3a4a5a;
}
QHeaderView::section {
    background: #383838;
    color: #e0e0e0;
    padding: 2px 4px;
    border: none;
    border-right: 1px solid #3c3c3c;
    border-bottom: 1px solid #3c3c3c;
    font-weight: bold;
}

/* --- Module control panel ------------------------------------------------
   The separator between the Controls dock and the central figure grid is
   drawn HERE, on the content widget, not on the QDockWidget itself: the dock
   frame is fully covered by its content and never paints a visible border.
   This mirrors how the Data Browser dock relies on its inner QTreeWidget
   border rather than the dock frame. */
QWidget#moduleControlPanel {
    background: #1e1e1e;
    border-left: 2px solid #7a7a7a;
}
QStackedWidget#moduleControlsSurface {
    background: #1e1e1e;
    border: 1px solid #3c3c3c;
}
QScrollArea#moduleControlsScroll,
QScrollArea#moduleControlsScroll > QWidget > QWidget,
QWidget#moduleControlsContent {
    background: #1e1e1e;
}
QLabel#moduleTitle {
    font-size: 10pt;
    font-weight: bold;
    color: #e0e0e0;
    padding: 2px 0;
}
QLabel#sectionTitle {
    font-size: 9pt;
    font-weight: bold;
    color: #b0b0b0;
}

/* --- Group boxes (flat cards) ------------------------------------------- */
QGroupBox {
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    margin-top: 5px;
    padding: 5px;
    padding-top: 19px;
    background: #2f2f2f;
    color: #e0e0e0;
    font-weight: bold;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 0px;
    margin-left: 0px;
    padding: 2px 6px;
    background: #3a3a3a;
    border: none;
    border-radius: 0px;
    color: #d0d0d0;
}

/* --- Table-like parameter forms (object-name paramForm) ----------------- */
QGroupBox#paramForm {
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    background: #2b2b2b;
}
QGroupBox#paramForm::title {
    background: #333333;
    border-bottom: 1px solid #3c3c3c;
    border-radius: 0px;
    padding: 2px 6px;
    color: #e0e0e0;
}
/* Inputs inside param-form boxes: deep field with a visible border so they
   stay distinct from the equally-dark panel background. */
QGroupBox#paramForm QLineEdit,
QGroupBox#paramForm QComboBox,
QGroupBox#paramForm QSpinBox,
QGroupBox#paramForm QDoubleSpinBox {
    background: #1a1a1a;
    border: 1px solid #555555;
    min-height: 22px;
    max-height: 24px;
    border-radius: 2px;
}
QGroupBox#paramForm QLineEdit:hover,
QGroupBox#paramForm QComboBox:hover,
QGroupBox#paramForm QSpinBox:hover,
QGroupBox#paramForm QDoubleSpinBox:hover {
    border: 1px solid #4a9eff;
}
/* Flat buttons inside param-form boxes. */
QGroupBox#paramForm QPushButton {
    min-height: 24px;
    border-radius: 2px;
}
QLabel#propertyGridLabel {
    color: #e0e0e0;
    border-right: 1px solid #444444;
    border-bottom: 1px solid #3c3c3c;
    padding: 3px 6px;
    min-height: 22px;
    font-weight: normal;
}
QLabel#propertyGridLabel[rowParity="even"],
#propertyGridValue[rowParity="even"] {
    background: #303030;
}
QLabel#propertyGridLabel[rowParity="odd"],
#propertyGridValue[rowParity="odd"] {
    background: #383838;
}
#propertyGridValue,
QWidget#propertyGridAction {
    border-bottom: 1px solid #3c3c3c;
}
QWidget#propertyGridAction {
    padding-top: 3px;
    padding-bottom: 3px;
}
/* --- Tables -------------------------------------------------------------- */
QTableWidget {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    gridline-color: #404040;
    alternate-background-color: #252525;
}
QTableWidget::item:selected {
    background: #4a9eff;
    color: #ffffff;
}
QHeaderView::section {
    background: #383838;
}

/* --- Inputs (combo / spin / line edit) ---------------------------------- */
QComboBox,
QSpinBox,
QDoubleSpinBox,
QLineEdit {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #404040;
    border-radius: 2px;
    padding: 1px 4px;
    min-height: 22px;
    selection-background-color: #4a9eff;
    selection-color: #ffffff;
}
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover,
QLineEdit:hover {
    background: #252525;
}
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus,
QLineEdit:focus {
    border: 1px solid #4a9eff;
}
QComboBox QAbstractItemView {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #404040;
    selection-background-color: #4a9eff;
    selection-color: #ffffff;
}
QComboBox QAbstractItemView::item {
    padding: 1px 5px;
}

/* --- Buttons ------------------------------------------------------------- */
QPushButton {
    background: #383838;
    color: #e0e0e0;
    border: 1px solid #404040;
    border-radius: 2px;
    padding: 2px 10px;
    min-height: 19px;
}
QPushButton:hover {
    background: #424242;
}
QPushButton:pressed {
    background: #4a9eff;
    color: #ffffff;
}
QPushButton:disabled {
    background: #2b2b2b;
    color: #666666;
    border: 1px solid #333333;
}
QWidget#dataPreviewBar {
    background: #252525;
    border-top: 1px solid #4a4a4a;
}
QLabel#dataPreviewHint {
    color: #a8a8a8;
    font-size: 8pt;
    padding-left: 1px;
}
QPushButton#previewSelectedButton {
    background: #245f86;
    color: #ffffff;
    border: 1px solid #4a9eff;
    border-top-color: #75b9ff;
    border-left-color: #75b9ff;
    font-weight: bold;
    min-height: 24px;
    max-height: 28px;
    padding: 3px 12px;
}
QPushButton#previewSelectedButton:hover,
QPushButton#previewSelectedButton:focus {
    background: #2f739d;
    border: 1px solid #75b9ff;
}
QPushButton#previewSelectedButton:pressed {
    background: #4a9eff;
    color: #ffffff;
    border: 1px solid #2d5f86;
}
QPushButton#previewSelectedButton:disabled {
    background: #2b2b2b;
    color: #777777;
    border: 1px solid #3a3a3a;
    font-weight: bold;
}
QWidget#moduleControlPanel QPushButton {
    background: #383838;
    border: 1px solid #555555;
    padding: 2px 8px;
    min-height: 20px;
    max-height: 24px;
}
QWidget#moduleControlPanel QPushButton:hover,
QWidget#moduleControlPanel QPushButton:focus {
    background: #424242;
    border: 1px solid #4a9eff;
}
QWidget#moduleControlPanel QPushButton:pressed {
    background: #4a9eff;
    color: #ffffff;
}
QWidget#moduleControlPanel QPushButton:disabled {
    background: #2b2b2b;
    color: #666666;
    border: 1px solid #333333;
}

/* --- Check boxes & radio ------------------------------------------------- */
QCheckBox,
QRadioButton {
    color: #e0e0e0;
    spacing: 6px;
}
QCheckBox::indicator,
QRadioButton::indicator {
    width: 12px;
    height: 12px;
    border: 1px solid #555555;
    border-radius: 2px;
    background: #1e1e1e;
}
QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    background: #252525;
}
QCheckBox::indicator:checked {
    background: #2db84d;
    border: 1px solid #2db84d;
}
QCheckBox::indicator:checked:hover {
    background: #38c95b;
    border: 1px solid #38c95b;
}

/* --- Progress bar -------------------------------------------------------- */
QProgressBar {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    text-align: center;
    min-height: 16px;
    max-height: 18px;
}
QProgressBar::chunk {
    background: #4a9eff;
    border-radius: 0px;
}

/* --- Tabs ---------------------------------------------------------------- */
QTabWidget::pane {
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    background: #1e1e1e;
}
QTabBar::tab {
    background: #2b2b2b;
    color: #a0a0a0;
    border: 1px solid #3c3c3c;
    border-bottom: none;
    padding: 3px 9px;
    margin-right: 2px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}
QTabBar::tab:selected {
    background: #1e1e1e;
    color: #4a9eff;
    border-bottom: 1px solid #1e1e1e;
    font-weight: bold;
}
QTabBar::tab:hover:!selected {
    background: #383838;
    color: #e0e0e0;
}

/* --- Text outputs (logs) ------------------------------------------------- */
QPlainTextEdit,
QTextEdit {
    background: #1e1e1e;
    color: #c0c0c0;
    border: 1px solid #3c3c3c;
    border-radius: 2px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
}
/* --- Status bar ---------------------------------------------------------- */
QStatusBar {
    background: #333333;
    color: #b0b0b0;
    border-top: 1px solid #3c3c3c;
}
QStatusBar::item {
    border: none;
}
QStatusBar QLabel {
    color: #b0b0b0;
    padding: 0 6px;
}

/* --- Scroll bars --------------------------------------------------------- */
QScrollBar:vertical {
    background: #2b2b2b;
    width: 12px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #4a4a4a;
    border-radius: 0px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #4a9eff;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: #2b2b2b; }
QScrollBar:horizontal {
    background: #2b2b2b;
    height: 12px;
    border: none;
}
QScrollBar::handle:horizontal {
    background: #4a4a4a;
    border-radius: 0px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #4a9eff;
}
QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal { background: #2b2b2b; }

/* --- Scroll area --------------------------------------------------------- */
QScrollArea {
    background: transparent;
    border: none;
}

/* --- Dock widgets -------------------------------------------------------- */
QDockWidget {
    color: #e0e0e0;
    border: 1px solid #5a5a5a;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}
/* Note: a separator between the Controls dock and the central figure grid is
   intentionally drawn on #moduleControlPanel (the dock's content widget) rather
   than here — the QDockWidget frame is covered by its content and does not
   paint a visible border. See #moduleControlPanel above. */
QDockWidget::title {
    background: #1f1f1f;
    border-bottom: 2px solid #5a5a5a;
    padding: 3px 6px;
    text-align: left;
    color: #e0e0e0;
    font-weight: bold;
}

/* --- Message box --------------------------------------------------------- */
QMessageBox {
    background: #2b2b2b;
}
QMessageBox QLabel {
    color: #e0e0e0;
}

/* --- Tool tip ------------------------------------------------------------ */
QToolTip {
    background: #1e1e1e;
    color: #e0e0e0;
    border: 1px solid #4a9eff;
    padding: 4px;
}

/* --- Scroll area content margins ---------------------------------------- */
QLabel {
    color: #e0e0e0;
    background: transparent;
}

/* --- Figure panel title -------------------------------------------------- */
QLabel#viewerTitle {
    background: #1e1e1e;
    color: #b0b0b0;
    font-weight: bold;
    padding: 2px 5px;
}
